# habitat-radiomics-pca-lnm — environment variables
#
# Copy to .env and fill in the paths that exist on your machine, or export the
# variables directly in your shell.  Nothing here is a secret; the values are
# paths only, and every one of them is left blank on purpose.
#
# Unset variables cause the corresponding verifier to exit 3 (fail-closed),
# which is intended: a check that cannot reach its inputs must never report PASS.
#
# See README §11 for which module consumes which variable.

# --- submitted documents (read by src/hrpca/paper.py) ----------------------
HRPCA_MANUSCRIPT=
HRPCA_SUPPLEMENT=

# --- online-data CSVs (read by src/hrpca/online.py) ------------------------
HRPCA_ONLINE_DIR=

# --- working archive (read by the verify/ scripts) -------------------------
HRPCA_ARCHIVE_ROOT=

# --- authoritative clinical table -----------------------------------------
HRPCA_CLINIC_CSV=

# --- controlled individual-level store (synthetic-data generator) ----------
HRPCA_CONTROLLED_DIR=

# --- identifier map (never committed; needed only for pseudonymisation
#     and for verify/scan_identifiers.py --gate) ----------------------------
HRPCA_ID_MAP=
HRPCA_ID_MAP_DIR=

# --- deployment roots consumed by config/config.yaml as ${VAR} ------------
HRPCA_DEPLOY_ROOT=
HRPCA_SOL21_K5=
HRPCA_SOL21_K4=
HRPCA_SOL21_K7=
